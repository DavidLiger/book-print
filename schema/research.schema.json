{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lang": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "es"
      ]
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "pattern": "\\S"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                },
                "title": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "publisher": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "published": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "accessed": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                },
                "support": {
                  "type": "string",
                  "maxLength": 400,
                  "pattern": "\\S"
                }
              },
              "required": [
                "url",
                "title",
                "publisher",
                "accessed",
                "support"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "forte",
              "debattue"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "sources",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "chapeau",
              "texte",
              "paragraphe",
              "encadre",
              "fiche",
              "chiffre-cle",
              "legende",
              "etiquette"
            ]
          },
          "item": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "claims": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "paragraphe": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "heading": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "zone",
          "type",
          "text",
          "claims"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "subjectId",
    "lang",
    "generatedAt",
    "claims",
    "blocks"
  ],
  "additionalProperties": false
}
